    {
      "_id": "fld_preorders",
      "_type": "request_group",
      "parentId": "wrk_elyeter",
      "name": "4 · Pre-orders",
      "description": "No payment in the app: the customer submits a pre-order and a manager calls back. The cart lives on the device and is only sent here.\n\nBoth write endpoints call AliExpress live, so they take a few seconds — and they currently answer 503 pre-order-availability-check-failed, because the supplier authorization has expired. That path is worth building against now; the happy path becomes testable once an operator re-runs OAuth.",
      "environment": {},
      "environmentPropertyOrder": null,
      "metaSortKey": -700
    },
    {
      "_id": "req_check",
      "_type": "request",
      "parentId": "fld_preorders",
      "name": "Check availability",
      "description": "Validation only — nothing is created, and an unavailable line is a normal 200, not an error.\n\nUp to 30 lines, quantity 1-99, duplicates merged server-side. variant_id is required when the product has has_variants: true.\n\nitems[].status: available, insufficient_stock, out_of_stock, unavailable, not_found. items[].message is ready to display in the requested language.\n\nErrors: 400 variant-required (details.product_id names the line), 503 pre-order-availability-check-failed (supplier silent — do not clear the cart), 429 too-many-requests (20/min per user).",
      "method": "POST",
      "url": "{{ _.base_url }}/pre-orders/check",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 3,\n      \"variant_id\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Content-Language",
          "value": "{{ _.lang }}",
          "description": "tk or ru; absent means tk"
        }
      ],
      "authentication": {
        "type": "bearer",
        "token": "{{ _.access_token }}",
        "prefix": "",
        "disabled": false
      },
      "metaSortKey": -1000,
      "isPrivateBase": false,
      "settingsStoreCookies": true,
      "settingsSendCookies": true,
      "settingsDisableRenderRequestBody": false,
      "settingsEncodeUrl": true,
      "settingsRebuildPath": true,
      "settingsFollowRedirects": "global"
    },
